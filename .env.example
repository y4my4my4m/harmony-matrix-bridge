# Copy to .env, chmod 600 .env, and fill in locally. Never commit the copy.

# Managed by Harmony (Server settings, Bridges, Matrix):
# HARMONY_URL=https://harmony.example.org
# HARMONY_SETUP_CODE=MX-XXXX-XXXX-XXXX
# MATRIX_HOMESERVER_URL=https://matrix.example.org
#   as an application service:
# MATRIX_SERVER_NAME=example.org
# MATRIX_APPSERVICE_URL=http://bridge-host:9009
#   or as an ordinary account:
# MATRIX_ACCESS_TOKEN=

# The bridges of a Harmony instance (its operator):
# BRIDGE_MODE=host
# HARMONY_URL=http://bot-gateway:3002
# HARMONY_PUBLIC_URL=https://harmony.example.org
# BRIDGE_HOST_SECRET=

# With config.json and a bot of your own. Generate each Matrix token by itself: openssl rand -hex 32
HARMONY_TOKEN=harmony_bot_REPLACE_WITH_YOUR_BOT_TOKEN
MATRIX_AS_TOKEN=REPLACE_WITH_AN_INDEPENDENT_RANDOM_TOKEN
MATRIX_HS_TOKEN=REPLACE_WITH_ANOTHER_INDEPENDENT_RANDOM_TOKEN
# MATRIX_BRIDGE_CONFIG=./config.json
